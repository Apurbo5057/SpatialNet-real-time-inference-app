{
  "model_name": "SpatialNetFastest",
  "input_size": 160,
  "input_channels": 3,
  "input_format": "NHWC",
  "normalization_mean": [
    0.485,
    0.456,
    0.406
  ],
  "normalization_std": [
    0.229,
    0.224,
    0.225
  ],
  "output_size": 13,
  "output_layout": {
    "hand_bbox": {
      "start": 0,
      "end": 4,
      "format": "cx,cy,w,h"
    },
    "fingertip": {
      "start": 4,
      "end": 6,
      "format": "x,y"
    },
    "pointing_dir": {
      "start": 6,
      "end": 8,
      "format": "sin,cos"
    },
    "roi_bbox": {
      "start": 8,
      "end": 12,
      "format": "cx,cy,w,h"
    },
    "objectness": {
      "start": 12,
      "end": 13,
      "format": "confidence"
    }
  },
  "quantization_variants": {
    "fp32": "model_fp32.tflite",
    "fp16": "model_fp16.tflite",
    "int8": "model_int8.tflite"
  }
}